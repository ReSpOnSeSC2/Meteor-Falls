{
  "name": "meteor-falls",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "METEOR FALLS — an EarthBound-style RPG. Five kids, ten Embers, one planet at the end of the road.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && npm run validate && vite build",
    "preview": "vite preview --host",
    "validate": "vite-node tools/content-validate.ts",
    "bench:map": "vite-node tools/bench-map.ts --",
    "balance": "vite-node tools/balance-sim.ts",
    "scaffold": "vite-node tools/chapter-scaffold.ts --",
    "encounters": "vite-node tools/encounter-report.ts",
    "test": "npm run validate && vitest run",
    "test:watch": "vitest",
    "art:appart": "vite-node tools/render-appart.ts",
    "art:pkg01": "vite-node tools/render-pkg01.ts",
    "art:castsheet": "vite-node tools/cast-sheet.ts",
    "art:facesheet": "vite-node tools/forge-faces.ts",
    "art:buildings": "vite-node tools/render-buildings.ts",
    "art:vehicles": "vite-node tools/render-vehicles.ts",
    "art:icons": "vite-node tools/render-icons.ts",
    "art:glyphs": "vite-node tools/render-glyphs.ts",
    "art:flair": "vite-node tools/render-flair.ts",
    "android:sync": "npm run build && npm run art:appart && cap sync android",
    "android:apk": "npm run android:sync && cd android && .\\gradlew assembleDebug && cd .. && node tools/collect-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "phaser": "^3.87.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/node": "^25.9.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
