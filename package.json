{
  "name": "meteor-falls",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "METEOR FALLS — an EarthBound-style RPG. Five kids, ten Embers, one planet at the end of the road.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && npm run validate && vite build",
    "preview": "vite preview --host",
    "validate": "vite-node tools/content-validate.ts",
    "visuals:audit": "vite-node tools/visual-identity-audit.ts",
    "visuals:audit:strict": "vite-node tools/visual-identity-audit.ts --strict",
    "anim:audit": "vite-node tools/character-animation-audit.ts",
    "anim:audit:strict": "vite-node tools/character-animation-audit.ts --strict",
    "anim:frame": "vite-node tools/character-frame-export.ts --",
    "anim:frame:check": "vite-node tools/character-frame-check.ts --",
    "anim:fix": "vite-node tools/character-animation-fix.ts --",
    "blender:check": "vite-node tools/blender-check.ts",
    "blender:rig": "vite-node tools/blender-rig.ts --",
    "blender:frame": "vite-node tools/blender-frame.ts --",
    "blender:motion": "vite-node tools/blender-motion.ts --",
    "bench:map": "vite-node tools/bench-map.ts --",
    "balance": "vite-node tools/balance-sim.ts",
    "scaffold": "vite-node tools/chapter-scaffold.ts --",
    "encounters": "vite-node tools/encounter-report.ts",
    "test": "npm run validate && vitest run",
    "test:watch": "vitest",
    "resheet": "vite-node tools/resheet.ts --",
    "art:appart": "vite-node tools/render-appart.ts",
    "android:sync": "npm run build && npm run art:appart && cap sync android",
    "android:apk": "npm run android:sync && cd android && .\\gradlew assembleDebug && cd .. && node tools/collect-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "phaser": "^3.87.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/node": "^25.9.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
